# MindTrack - Environment Variables
# Copy to .env and adjust values for your environment

PROJECT_NAME="MindTrack"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local Encryption Master Key (Base64-encoded 32-byte Fernet key)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY="replace-with-fernet-compatible-base64-key"

# Database
DATABASE_URL="sqlite:///./mindtrack.db"

# LLM Provider Configuration for Weekly Summaries (cloud | openai | mock)
LLM_PROVIDER="cloud-api"
LLM_API_KEY="your-llm-api-key-here"

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
